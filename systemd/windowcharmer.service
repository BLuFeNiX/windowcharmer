[Unit]
Description=WindowCharmer window tiling daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/windowcharmer
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# To enable debug logging, override ExecStart via `systemctl --user edit windowcharmer`:
# [Service]
# ExecStart=
# ExecStart=%h/.local/bin/windowcharmer --debug

[Install]
WantedBy=graphical-session.target
